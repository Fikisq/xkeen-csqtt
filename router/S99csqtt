#!/bin/sh
DIR="/opt/etc/csqtt"
# Entware's boot sweep must preserve an explicit stop from the panel.
# A direct start (panel or CLI) still clears the marker in the start branch.
if [ "${1:-}" = start ] && [ -f "$DIR/stopped" ]; then
    boot_parent=$(tr '\000' ' ' < "/proc/${PPID:-0}/cmdline" 2>/dev/null)
    case "$boot_parent" in
        */rc.unslung*) echo 'CSQTT: сохранено остановленное состояние'; exit 0 ;;
    esac
fi
owns_pid() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$1/cmdline" ] || return 1
    case "$(tr '\000' ' ' < "/proc/$1/cmdline")" in
        *"$DIR/csqtt-client"*|*"$DIR/csqtt-run.sh"*|*"$DIR/csqtt-run-219.sh"*|*"$DIR/csqtt-run-250.sh"*) return 0 ;;
    esac
    return 1
}
owns_tun_helper_pid() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$1/cmdline" ] || return 1
    case "$(tr '\000' ' ' < "/proc/$1/cmdline")" in
        *"$DIR/csqtt-tun-fd"*) return 0 ;;
    esac
    return 1
}
owns_native_events_pid() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$1/cmdline" ] || return 1
    case "$(tr '\000' ' ' < "/proc/$1/cmdline")" in
        *"$DIR/csqtt-native-events"*) return 0 ;;
    esac
    return 1
}
owns_dns_loop_pid() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$1/cmdline" ] || return 1
    case "$(tr '\000' ' ' < "/proc/$1/cmdline")" in
        *"$DIR/csqtt-run-250.sh"*) return 0 ;;
    esac
    return 1
}
case "$1" in
    start)
        printf 'Starting CSQTT: '
        if [ -f "/var/run/csqtt.pid" ] && owns_pid "$(cat "/var/run/csqtt.pid")"; then
            echo "уже запущен"; exit 0
        fi
        version=$(tr -d '\r' < "$DIR/client-version" 2>/dev/null | tr -d '[:space:]')
        case "$version" in
            2.1.9|2.1.9-router250.1|2.1.9-router250.2)
                RUN_SCRIPT="$DIR/csqtt-run-219.sh"
                ;;
            2.5.0-apk-router)
                RUN_SCRIPT="$DIR/csqtt-run-250.sh"
                mode=$( . "$DIR/csqtt.conf" && printf '%s' "${VK_HASH_MODE:-auto_js}" ) || exit 1
                case "$mode" in
                    manual|auto_api|auto_js) ;;
                    *) echo "Неизвестный режим VK" >&2; exit 1 ;;
                esac
                ;;
            *) echo "Неподдерживаемая версия CSQTT: ${version:-не указана}" >&2; exit 1 ;;
        esac
        [ -x "$RUN_SCRIPT" ] || { echo "не найден исполняемый сценарий CSQTT" >&2; exit 1; }
        if [ -s "$DIR/vk_api_calls" ] || [ -s "$DIR/vk_api_calls.stale" ] || [ -f "$DIR/vk_api_calls.uncertain" ]; then
            "$DIR/csqtt-api-calls.sh" stop || { echo "прежние звонки Auto API не закрыты" >&2; exit 1; }
        fi
        "$DIR/csqtt-js-calls.sh" || { echo "прежний звонок Auto VK не закрыт" >&2; exit 1; }
        rm -f "$DIR/stopped"
        nohup "$RUN_SCRIPT" >>"$DIR/csqtt.log" 2>&1 &
        echo $! > "/var/run/csqtt.pid"
        echo "OK (PID $(cat "/var/run/csqtt.pid"))"
        ;;
    stop)
        printf 'Stopping CSQTT: '
        touch "$DIR/stopped"
        if [ -f "/var/run/csqtt.pid" ]; then
            PID=$(cat "/var/run/csqtt.pid")
            if owns_pid "$PID"; then
                if [ "$(readlink "/proc/$PID/fd/0" 2>/dev/null)" = "$DIR/bootstrap.fifo" ]; then
                    # Auto VK's client explicitly finishes its calls only after
                    # this control command. STOP lets it drain before a signal.
                    (printf 'FINISH_VK_CALLS\nSTOP\n' > "$DIR/bootstrap.fifo") &
                    WRITER=$!
                    w=0
                    while kill -0 "$WRITER" 2>/dev/null && [ "$w" -lt 3 ]; do
                        sleep 1; w=$((w+1))
                    done
                    kill -0 "$WRITER" 2>/dev/null && kill "$WRITER" 2>/dev/null
                    wait "$WRITER" 2>/dev/null || true
                else
                    case "$(tr '\000' ' ' < "/proc/$PID/cmdline")" in
                        *"$DIR/csqtt-run-219.sh"*|*"$DIR/csqtt-run-250.sh"*) kill -TERM "$PID" 2>/dev/null ;;
                        *) kill -INT "$PID" 2>/dev/null ;;
                    esac
                fi
                n=0
                while owns_pid "$PID" && [ $n -lt 75 ]; do
                    sleep 1; n=$((n+1))
                done
                owns_pid "$PID" && kill -INT "$PID" 2>/dev/null
                n=0
                while owns_pid "$PID" && [ $n -lt 10 ]; do
                    sleep 1; n=$((n+1))
                done
                owns_pid "$PID" && kill -9 "$PID" 2>/dev/null
            fi
            rm -f "/var/run/csqtt.pid"
        fi
        cleanup_failed=0
        "$DIR/csqtt-js-calls.sh" || { echo "звонок Auto VK не завершён" >&2; cleanup_failed=1; }
        if [ -f "$DIR/vk_api_calls" ] || [ -f "$DIR/vk_api_calls.stale" ] || [ -f "$DIR/vk_api_calls.uncertain" ]; then
            "$DIR/csqtt-api-calls.sh" stop || { echo "звонки Auto API не завершены" >&2; cleanup_failed=1; }
        fi
        KEEP_MANUAL_STAGE=${KEEP_MANUAL_STAGE:-0} /opt/bin/vk-manual-hashes.sh stop csqtt || { echo "ручные звонки VK не завершены" >&2; cleanup_failed=1; }
        if [ -f "$DIR/csqtt-dns-loop.pid" ]; then
            DNS_LOOP_PID=$(cat "$DIR/csqtt-dns-loop.pid")
            if owns_dns_loop_pid "$DNS_LOOP_PID"; then
                kill -TERM "$DNS_LOOP_PID" 2>/dev/null
                d=0
                while owns_dns_loop_pid "$DNS_LOOP_PID" && [ "$d" -lt 10 ]; do
                    sleep 1; d=$((d + 1))
                done
                if owns_dns_loop_pid "$DNS_LOOP_PID"; then
                    echo "цикл DNS ещё завершает работу; правила не очищены" >&2
                    cleanup_failed=1
                else
                    rm -f "$DIR/csqtt-dns-loop.pid"
                fi
            else
                rm -f "$DIR/csqtt-dns-loop.pid"
            fi
        fi
        if [ ! -f "$DIR/csqtt-dns-loop.pid" ] && [ -x "$DIR/csqtt-dns-sync.sh" ]; then
            "$DIR/csqtt-dns-sync.sh" clear || { echo "собственные правила DNS не очищены" >&2; cleanup_failed=1; }
        fi
        if [ -f "$DIR/csqtt-tun-fd.pid" ]; then
            HELPER_PID=$(cat "$DIR/csqtt-tun-fd.pid")
            owns_tun_helper_pid "$HELPER_PID" && kill "$HELPER_PID" 2>/dev/null
            rm -f "$DIR/csqtt-tun-fd.pid"
        fi
        if [ -f "$DIR/csqtt-native-events.pid" ]; then
            ADAPTER_PID=$(cat "$DIR/csqtt-native-events.pid")
            owns_native_events_pid "$ADAPTER_PID" && kill "$ADAPTER_PID" 2>/dev/null
            rm -f "$DIR/csqtt-native-events.pid"
        fi
        [ "$cleanup_failed" -eq 0 ] || exit 1
        echo "OK"
        ;;
    restart)
        touch "$DIR/restarting"
        KEEP_MANUAL_STAGE=1 "$0" stop || exit 1
        sleep 1
        "$0" start
        rm -f "$DIR/restarting"
        ;;
    status)
        if [ -f "/var/run/csqtt.pid" ] && owns_pid "$(cat "/var/run/csqtt.pid")"; then
            echo "CSQTT работает (PID $(cat "/var/run/csqtt.pid"))"
        else
            echo "CSQTT остановлен"
        fi
        ;;
    log) tail -n 100 "$DIR/csqtt.log" ;;
    *) echo "Usage: $0 start|stop|restart|status|log" ;;
esac
