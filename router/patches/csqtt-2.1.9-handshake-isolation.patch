+// Opt-in, secret-free connection stages. Independent of CSQTT_EVENTS:
+// enabling Android events on a headless client also changes stdin/EOF handling.
+use crate::stats::Stats;
+use std::{sync::{Arc, LazyLock, atomic::Ordering}, time::Instant};
+use tokio_util::sync::CancellationToken;
+
+static ENABLED: LazyLock<bool> = LazyLock::new(||
+    std::env::var("CSQTT_DIAGNOSTICS").as_deref() == Ok("1"));
+
+pub(crate) struct ConnectionTrace {
+    worker: usize,
+    phase: &'static str,
+    started: Option<Instant>,
+    stats: Arc<Stats>,
+    cancel: CancellationToken,
+}
+
+impl ConnectionTrace {
+    pub(crate) fn new(worker: usize, stats: Arc<Stats>, cancel: CancellationToken) -> Self {
+        Self { worker, phase: "start", started: (*ENABLED).then(Instant::now), stats, cancel }
+    }
+
+    pub(crate) fn phase(&mut self, phase: &'static str) {
+        self.phase = phase;
+        self.emit("stage");
+    }
+
+    fn emit(&self, event: &str) {
+        if let Some(started) = self.started {
+            crate::log_error!(
+                "[CSQTT_DIAG] event={} worker={} phase={} elapsed_ms={} active={} cancelled={}",
+                event, self.worker, self.phase, started.elapsed().as_millis(),
+                self.stats.active_connections.load(Ordering::Acquire), self.cancel.is_cancelled(),
+            );
+        }
+    }
+}
+
+impl Drop for ConnectionTrace {
+    fn drop(&mut self) { self.emit("session_end"); }
+}
+
+pub(crate) fn retry(worker: usize, attempt: usize, delay_ms: u128, active: i32) {
+    if *ENABLED {
+        crate::log_error!(
+            "[CSQTT_DIAG] event=retry worker={} attempt={} delay_ms={} active={}",
+            worker, attempt, delay_ms, active,
+        );
+    }
+}
+
+pub(crate) fn lifecycle(reason: &'static str) {
+    if *ENABLED {
+        crate::log_error!("[CSQTT_DIAG] event=client_stop reason={}", reason);
+    }
+}
