+// Local fault injection: no VK account, router, or external server is used.
+use super::*;
+use crate::obfs::{ObfsCipher, ObfsConfig, ObfsState};
+
+async fn configuration_peer(socket: Arc<UdpSocket>, response: &'static [u8], stop: CancellationToken) {
+    let pool = PacketPool::new(8);
+    let cipher = ObfsCipher::new(derive_wrap_key("local-fixture-password").unwrap()).unwrap();
+    let config = ObfsConfig::new(ObfsMode::Audio);
+    let mut state = ObfsState::new();
+    let mut buffer = [0u8; 4096];
+    loop {
+        let (len, source) = tokio::select! {
+            _ = stop.cancelled() => return,
+            result = socket.recv_from(&mut buffer) => result.unwrap(),
+        };
+        let mut packet = pool.acquire();
+        packet.read_area()[..len].copy_from_slice(&buffer[..len]);
+        packet.set_read_len(len).unwrap();
+        cipher.unwrap(&mut packet, ObfsMode::Audio).unwrap();
+        let answer = if packet.as_slice().starts_with(b"GETCONF:") {
+            response
+        } else if packet.as_slice().starts_with(b"DISCONNECT:") {
+            b"OK:disconnected".as_slice()
+        } else {
+            continue;
+        };
+        drop(packet);
+        let mut reply = pool.acquire();
+        reply.read_area()[..answer.len()].copy_from_slice(answer);
+        reply.set_read_len(answer.len()).unwrap();
+        cipher.wrap(&mut reply, &config, &mut state).unwrap();
+        socket.send_to(reply.as_slice(), source).await.unwrap();
+    }
+}
+
+fn fixture_session(
+    id: usize, endpoint: SocketAddr, peer: SocketAddr, get_config: bool,
+    dispatcher: Arc<Dispatcher>, stats: Arc<Stats>, cancel: CancellationToken,
+    ready: oneshot::Sender<()>,
+) -> tokio::task::JoinHandle<anyhow::Result<bool>> {
+    let (config_tx, _config_rx) = tokio::sync::mpsc::channel(8);
+    tokio::spawn(run_session(
+        SessionConfig {
+            id, peer, turn_host: None, turn_port: None,
+            turn_transport: TurnTransportMode::Udp,
+            local_port: Arc::from("39002"), device_id: Arc::from("local-fixture"),
+            password: Arc::from("local-fixture-password"), generation: 1,
+            salt: Arc::from("local-fixture"), mode: ObfsMode::Audio,
+            wrap_key: derive_wrap_key("local-fixture-password").unwrap(),
+            get_config, desired_count: 9, turn_endpoint_cursor: 0,
+            server_stream_repair: Arc::new(AtomicBool::new(false)), repair: RepairState::new(9),
+        },
+        TurnCredentials {
+            username: Arc::from(USERNAME), password: Arc::from(PASSWORD),
+            server_addresses: vec![Arc::from(format!("turn:{endpoint}?transport=udp"))].into(),
+        },
+        SessionRuntime {
+            dispatcher, pool: PacketPool::new(96), stats, events: Events::new(true), config_tx,
+            config_delivery: None, cancel, shutdown: Arc::new(ShutdownCoordinator::new()),
+            ready_tx: Some(ready), allocation_started: None, allocation_ready: None,
+        },
+    ))
+}
+
+// A real TURN Allocate/ChannelBind exchange precedes each injected fault.
+async fn isolated_failure(kind: &str) -> String {
+    let cancel = CancellationToken::new();
+    let stats = Arc::new(Stats::default());
+    let (dispatcher, _) = Dispatcher::start(
+        "127.0.0.1:0", None, PacketPool::new(128), stats.clone(), cancel.clone(),
+    ).await.unwrap();
+    let stop = CancellationToken::new();
+    let peer = Arc::new(UdpSocket::bind("127.0.0.1:0").await.unwrap());
+    let relay = Arc::new(UdpSocket::bind("127.0.0.1:0").await.unwrap());
+    let good_relay = tokio::spawn(relay_bound_turn_channel_to_peer(relay.clone(), peer.local_addr().unwrap(), stop.clone()));
+    let good_peer = tokio::spawn(configuration_peer(peer.clone(), b"NOCONF", stop.clone()));
+    let (ready_tx, ready_rx) = oneshot::channel();
+    let good = fixture_session(1, relay.local_addr().unwrap(), peer.local_addr().unwrap(), false,
+        dispatcher.clone(), stats.clone(), cancel.clone(), ready_tx);
+    tokio::time::timeout(Duration::from_secs(3), ready_rx).await.unwrap().unwrap();
+    // The ready notification precedes the active counter update in the
+    // original session. Wait for both before injecting a fast Allocate error.
+    tokio::time::timeout(Duration::from_secs(3), async {
+        while stats.active_connections.load(Ordering::Acquire) != 1 || dispatcher.active_count() != 1 {
+            tokio::time::sleep(Duration::from_millis(1)).await;
+        }
+    }).await.unwrap();
+
+    let bad_peer = Arc::new(UdpSocket::bind("127.0.0.1:0").await.unwrap());
+    let bad_relay = Arc::new(UdpSocket::bind("127.0.0.1:0").await.unwrap());
+    let relay_task = if kind == "allocate" {
+        let socket = bad_relay.clone();
+        tokio::spawn(async move {
+            let (wire, client) = recv_datagram(&socket).await;
+            let first = StunMessage::decode(&wire).unwrap();
+            socket.send_to(&challenge_response(first.transaction()), client).await.unwrap();
+            let (wire, client) = recv_datagram(&socket).await;
+            let auth = assert_authenticated_request(&wire, ALLOCATE_REQUEST);
+            socket.send_to(&authenticated_error(ALLOCATE_ERROR, auth.transaction(), 486), client).await.unwrap();
+        })
+    } else {
+        tokio::spawn(relay_bound_turn_channel_to_peer(bad_relay.clone(), bad_peer.local_addr().unwrap(), stop.clone()))
+    };
+    let denial = if kind == "denied" || kind == "device_mismatch" {
+        let response = if kind == "device_mismatch" { b"DENIED:device_mismatch".as_slice() }
+            else { b"DENIED:wrong_password".as_slice() };
+        Some(tokio::spawn(configuration_peer(bad_peer.clone(), response, stop.clone())))
+    } else { None };
+    let (ready_tx, mut ready_rx) = oneshot::channel();
+    let bad = fixture_session(2, bad_relay.local_addr().unwrap(), bad_peer.local_addr().unwrap(), true,
+        dispatcher.clone(), stats.clone(), cancel.clone(), ready_tx);
+    let started = std::time::Instant::now();
+    let result = tokio::time::timeout(Duration::from_secs(10), bad).await.unwrap().unwrap();
+    let error = result.expect_err("The injected fault must fail its own session");
+    assert!(!cancel.is_cancelled(), "One failed session cancelled the entire client");
+    assert!(!good.is_finished(), "The healthy session was terminated");
+    assert_eq!(dispatcher.active_count(), 1);
+    assert_eq!(stats.active_connections.load(Ordering::Acquire), 1);
+    assert!(ready_rx.try_recv().is_err(), "Failed session was marked READY");
+    if kind == "handshake" { assert!(started.elapsed() >= Duration::from_millis(5_000)); }
+    println!("ISOLATION: fault={kind} healthy=1 failed_ready=0 global_cancel=false elapsed_ms={}", started.elapsed().as_millis());
+    cancel.cancel();
+    tokio::time::timeout(Duration::from_secs(4), good).await.unwrap().unwrap().unwrap();
+    dispatcher.shutdown().await;
+    stop.cancel();
+    for task in [good_relay, good_peer, relay_task] {
+        tokio::time::timeout(Duration::from_secs(2), task).await.unwrap().unwrap();
+    }
+    if let Some(task) = denial { task.await.unwrap(); }
+    format!("{error:#}")
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn handshake_timeout_is_local_and_not_fatal() {
+    let error = isolated_failure("handshake").await;
+    assert!(error.contains("HANDSHAKE_TIMEOUT"), "{error}");
+    assert!(!error.contains("FATAL_"), "Network silence must not stop the Android tunnel: {error}");
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn allocation_failure_preserves_other_ready_session() {
+    let error = isolated_failure("allocate").await;
+    assert!(error.contains("486"), "{error}");
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn explicit_password_rejection_stays_fatal() {
+    let error = isolated_failure("denied").await;
+    assert!(error.contains("FATAL_AUTH"), "{error}");
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn password_bound_to_another_device_keeps_explicit_reason() {
+    let error = isolated_failure("device_mismatch").await;
+    assert!(error.contains("FATAL_AUTH"), "{error}");
+    assert!(error.contains("другому устройству"), "{error}");
+}
