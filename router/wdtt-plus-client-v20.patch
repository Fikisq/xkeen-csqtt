diff --git a/go_client/router_buffers_test.go b/go_client/router_buffers_test.go
new file mode 100644
index 0000000..a20e083
--- /dev/null
+++ b/go_client/router_buffers_test.go
@@ -0,0 +1,22 @@
+package main
+
+import "testing"
+
+func TestRouterPacketPoolSizes(t *testing.T) {
+	for _, size := range []int{0, 1, 32, 1500, 2048, 4096} {
+		b := getPktBuf(size)
+		if len(b) != size { t.Fatalf("size %d: got %d", size, len(b)) }
+		if size > 0 { b[size-1] = 7 }
+		putPktBuf(b)
+	}
+	putPktBuf(make([]byte, 10))
+}
+
+func BenchmarkRouterPacketPool(b *testing.B) {
+	b.ReportAllocs()
+	for i := 0; i < b.N; i++ {
+		packet := getPktBuf(1500)
+		packet[0] = 4
+		putPktBuf(packet)
+	}
+}
